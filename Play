// ============ الخلية 2: Multinomial Naive Bayes ============



// تنظيف النص العربي: حذف التشكيل، توحيد الأحرف، وإزالة علامات الترقيم

function normalize(text) {

  return text.replace(/[\u064B-\u0652]/g, "").replace(/[أإآ]/g, "ا").replace(/ة/g, "ه").replace(/ى/g, "ي")

    .replace(/[\u060C\u061B\u061F.,!?…"'()\-]/g, " ").toLowerCase().trim();

}



// تحويل النص لميزات: كلمات مفردة + كلمتين متتاليتين، والإيموجي كل واحد لحاله

function tokenize(text) {

  var spaced = normalize(text).replace(/([\u{1F300}-\u{1FAFF}\u2600-\u27BF])/gu, " $1 ");

  var words = spaced.split(/\s+/).filter(function (w) { return w.length > 0; });

  var tokens = words.slice();

  // لوب for: يبني الكلمتين المتتاليتين

  for (var i = 0; i < words.length - 1; i++) tokens.push(words[i] + "_" + words[i + 1]);

  return tokens;

}



